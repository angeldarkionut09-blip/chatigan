NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"
LOGIN_THROTTLE_SECRET=replace-with-a-long-random-secret

# Set these only in a private local .env or the deployment secret manager.
# Remove them from the runtime environment after the one-time bootstrap succeeds.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_PHONE=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional provider credentials are checked for presence only; secrets are never returned by the admin API.
SMS_PROVIDER_URL=
SMS_PROVIDER_API_KEY=
MAIL_PROVIDER_URL=
MAIL_PROVIDER_API_KEY=
